export type Camel<T> = T & {
  [K in keyof T as K extends `aria-${infer R}`
    ? `aria${Capitalize<R>}`
    : never]: T[K];
};

export interface Box<T> {
  /** Holds a value without spreading its type. */
  item?: T;
}

export interface Base extends Marko.HTML.Span {
  /** Declared in the project. */
  mine?: string;
}

export interface Input
  extends Camel<Base>,
    Camel<Omit<Marko.HTML.Img, `on${string}`>>,
    Box<Marko.HTML.Div> {}

<span/>
